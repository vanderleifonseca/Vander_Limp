@using VanderLimp.Admin.Servicos

@inject SessaoAdminServico Sessao
@inject AutenticacaoAdminApiServico Autenticacao
@inject NavigationManager Navegacao

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="login">
            Vander Limp
        </a>
    </div>
</div>

<input type="checkbox"
       title="Abrir ou fechar menu"
       aria-label="Abrir ou fechar menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Acesso administrativo
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="produtos">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                Produtos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clientes">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                Clientes
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <button type="button"
                    class="nav-link border-0 bg-transparent w-100"
                    disabled="@_saindo"
                    @onclick="SairAsync">
                @(_saindo ? "Saindo..." : "Sair")
            </button>
        </div>

    </nav>

    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <p class="text-warning px-3" role="alert">
            @_erro
        </p>
    }
</div>

@code {
    private bool _saindo;
    private string? _erro;

    private async Task SairAsync()
    {
        if (_saindo)
            return;

        _saindo = true;
        _erro = null;

        try
        {
            if (!string.IsNullOrWhiteSpace(Sessao.Token))
            {
                await Autenticacao.LogoutAsync(Sessao.Token);
            }

            Sessao.Limpar();

            // Descarta os dados da sessão anterior.
            Navegacao.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _erro =
                "Não foi possível conectar à API para sair. Tente novamente.";
        }
        catch (OperationCanceledException)
        {
            _erro =
                "O tempo de espera terminou. Tente sair novamente.";
        }
        catch (InvalidOperationException ex)
        {
            _erro = ex.Message;
        }
        catch (Exception)
        {
            _erro = "Não foi possível sair. Tente novamente.";
        }
        finally
        {
            _saindo = false;
        }
    }
}